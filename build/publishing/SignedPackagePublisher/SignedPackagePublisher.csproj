<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <!-- Keep this aligned with Microsoft.DotNet.Arcade.Sdk in global.json. -->
    <ArcadePublishingVersion>11.0.0-beta.26381.103</ArcadePublishingVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Feed" Version="$(ArcadePublishingVersion)" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="NuGet.Packaging" Version="7.0.3" />
    <Reference Include="Microsoft.DotNet.Build.Manifest" HintPath="$(PkgMicrosoft_DotNet_Build_Tasks_Feed)\tools\net\Microsoft.DotNet.Build.Manifest.dll" Private="true" />
  </ItemGroup>
</Project>
