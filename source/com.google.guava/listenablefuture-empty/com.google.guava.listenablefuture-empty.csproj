<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(_DefaultTargetFrameworks)</TargetFrameworks>
    <IsBindingProject>true</IsBindingProject>
    <AssemblyName>Xamarin.Google.Guava.ListenableFuture</AssemblyName>
    <RootNamespace>Google.Guava.ListenableFuture</RootNamespace>
    <PackageId>Xamarin.Google.Guava.ListenableFuture</PackageId>
    <PackageVersion>9999.0.0.1$(PackageVersionSuffix)</PackageVersion>
    <Description>.NET for Android bindings for com.google.guava:listenablefuture, without listenablefuture.jar. Xamarin.Google.Guava provides the Java types.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bind, but do not ship: guava.jar contains these types -->
    <InputJar Include="..\..\..\externals\com.google.guava\listenablefuture.jar" />
    <TransformFile Include="..\..\Metadata.common.xml" />
    <TransformFile Include="..\listenablefuture\Transforms\*.xml" Exclude="$(DefaultTransformExcludes)" />
    <Compile Include="..\..\AssemblyInfo.cs" />
    <None Include="..\..\..\build\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
</Project>
